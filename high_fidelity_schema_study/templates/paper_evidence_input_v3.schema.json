{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paper-evidence-input/v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "paper_id",
    "source_pdf_sha256",
    "layout_preprocessing_sha256",
    "span_conventions",
    "pages",
    "model_input_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "paper-evidence-input/v3"
    },
    "paper_id": {
      "type": "string",
      "minLength": 1
    },
    "source_pdf_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "layout_preprocessing_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "model_input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "span_conventions": {
      "type": "object"
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "page",
          "layout_mode",
          "text_regions",
          "tables"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "layout_mode": {
            "type": "string"
          },
          "text_regions": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/unit"
            }
          },
          "tables": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "table_id",
                "header_units",
                "rows",
                "caption"
              ]
            }
          }
        }
      },
      "minItems": 1
    }
  },
  "$defs": {
    "span": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "integer"
        },
        "end": {
          "type": "integer"
        }
      }
    },
    "unit": {
      "type": "object",
      "required": [
        "unit_id",
        "page",
        "region_kind",
        "reading_order",
        "bbox",
        "document_char_span",
        "document_token_span",
        "text"
      ],
      "properties": {
        "unit_id": {
          "type": "string"
        },
        "page": {
          "type": "integer"
        },
        "region_kind": {
          "type": "string"
        },
        "column_index": {
          "type": [
            "integer",
            "null"
          ]
        },
        "reading_order": {
          "type": "integer"
        },
        "bbox": {
          "type": "array"
        },
        "document_char_span": {
          "$ref": "#/$defs/span"
        },
        "document_token_span": {
          "$ref": "#/$defs/span"
        },
        "text": {
          "type": "string"
        }
      }
    }
  }
}