{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paper-evidence-layout/v6",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "paper_id", "source_pdf_sha256", "baseline_input_sha256", "middle_json_sha256", "raw_middle_json", "parser_identity", "mineru_output_identity", "page_count", "pages", "reading_text_sha256", "span_conventions", "preprocessing_sha256"],
  "properties": {
    "schema_version": {"const": "paper-evidence-layout/v6"},
    "paper_id": {"type": "string", "minLength": 1},
    "source_pdf_sha256": {"$ref": "#/$defs/sha"},
    "baseline_input_sha256": {"$ref": "#/$defs/sha"},
    "middle_json_sha256": {"$ref": "#/$defs/sha"},
    "raw_middle_json": {"type": "object"},
    "preprocessing_sha256": {"$ref": "#/$defs/sha"},
    "reading_text_sha256": {"$ref": "#/$defs/sha"},
    "parser_identity": {"type": "object", "required": ["schema_version", "parser", "version", "source_pdf_sha256", "raw_canonical_sha256", "raw_file_bytes_sha256", "model_manifest_sha256", "config_sha256", "tier", "ocr_mode", "parser_identity_sha256"], "properties": {
      "schema_version": {"const": "paper-parser-identity/v1"}, "parser": {"const": "mineru"},
      "version": {"type": "string", "minLength": 1}, "config": {"type": "object"}
    }},
    "mineru_output_identity": {"type": "object", "required": ["schema", "schema_version", "producer_version", "tier", "parse_mode"], "properties": {
      "schema": {"const": "docvortex.middle"}, "schema_version": {"const": "2.0"},
      "producer_version": {"type": "string", "minLength": 1},
      "tier": {"type": "string", "minLength": 1}, "parse_mode": {"type": "string", "minLength": 1}
    }},
    "page_count": {"type": "integer", "minimum": 1},
    "span_conventions": {"type": "object"},
    "pages": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["page", "page_idx", "width_pt", "height_pt", "regions", "tables", "blocks", "recovered_native_region_count", "native_table_recovery_count", "baseline_page", "coverage_ledger"], "properties": {
      "page": {"type": "integer", "minimum": 1}, "page_idx": {"type": "integer", "minimum": 0},
      "width_pt": {"type": "number", "exclusiveMinimum": 0}, "height_pt": {"type": "number", "exclusiveMinimum": 0},
      "regions": {"type": "array"}, "tables": {"type": "array"},
      "blocks": {"type": "array", "items": {"type": "object", "required": ["block_index", "type", "bbox", "raw", "disposition"], "properties": {
        "block_index": {"type": "integer", "minimum": 0}, "type": {"type": "string", "minLength": 1},
        "bbox": {"type": ["array", "null"]}, "raw": {"type": "object"},
        "disposition": {"enum": ["structured_table", "unresolved_table", "recognized_text", "empty_text_block", "recognized_visual_text", "nontext_visual", "unsupported_text_recovered", "unsupported_nontext"]}
      }}},
      "recovered_native_region_count": {"type": "integer", "minimum": 0},
      "native_table_recovery_count": {"type": "integer", "minimum": 0},
      "baseline_page": {"type": "object"},
      "coverage_ledger": {"type": "object"}
    }}}
  },
  "$defs": {"sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
