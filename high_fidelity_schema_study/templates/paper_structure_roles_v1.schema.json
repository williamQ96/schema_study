{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paper-structural-response/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "group_id", "unit_reviews", "table_roles", "mentions", "links"],
  "properties": {
    "schema_version": {"const": "paper-structural-response/v1"},
    "group_id": {"type": "string", "minLength": 1},
    "unit_reviews": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["unit_id", "state"], "properties": {"unit_id": {"type": "string"}, "state": {"enum": ["none", "candidate", "uncertain"]}}}},
    "table_roles": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["table_id", "purpose", "evidence", "columns"], "properties": {
      "table_id": {"type": "string"},
      "purpose": {"enum": ["dataset_schema", "raw_data", "summary_statistics", "model_results", "mixed", "other", "uncertain"]},
      "evidence": {"$ref": "#/$defs/evidence"},
      "columns": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["column_index", "role", "evidence"], "properties": {"column_index": {"type": "integer", "minimum": 0}, "role": {"enum": ["field_name", "variable_name", "unit", "value", "statistic", "sample_count", "class_label", "metadata", "unknown"]}, "evidence": {"$ref": "#/$defs/evidence"}}}}
    }}},
    "mentions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["mention_id", "kind", "label", "state", "categories", "evidence"], "properties": {
      "mention_id": {"type": "integer", "minimum": 0}, "kind": {"enum": ["field", "variable", "value", "statistic", "unit", "class_label"]},
      "label": {"type": "string", "minLength": 1}, "state": {"enum": ["candidate", "uncertain"]},
      "categories": {"$ref": "#/$defs/categories"}, "evidence": {"$ref": "#/$defs/evidence"}
    }}},
    "links": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["source_mention_id", "target_mention_id", "predicate", "state", "categories", "evidence"], "properties": {
      "source_mention_id": {"type": "integer", "minimum": 0}, "target_mention_id": {"type": "integer", "minimum": 0},
      "predicate": {"enum": ["has_unit", "has_value", "has_statistic", "same_field_as", "related_to"]},
      "state": {"enum": ["candidate", "uncertain"]}, "categories": {"$ref": "#/$defs/categories"},
      "evidence": {"$ref": "#/$defs/evidence"}
    }}}
  },
  "$defs": {
    "categories": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["structure", "encoding", "value", "syntax"]}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["unit_id", "quote"], "properties": {"unit_id": {"type": "string", "minLength": 1}, "quote": {"type": "string", "minLength": 1}}}
  }
}
