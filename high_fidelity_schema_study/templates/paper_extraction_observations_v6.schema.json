{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paper-extraction-group-response/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "coverage", "mentions", "facts"],
  "properties": {
    "schema_version": {"const": "paper-extraction-group-response/v2"},
    "coverage": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["window_id", "state"], "properties": {"window_id": {"type": "integer", "minimum": 0}, "state": {"enum": ["reviewed", "uncertain", "overflow"]}}}},
    "mentions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["kind", "normalized_label", "source_name", "context"], "properties": {"kind": {"$ref": "#/$defs/objectKind"}, "normalized_label": {"type": "string", "minLength": 1}, "source_name": {"$ref": "#/$defs/sourceName"}, "context": {"type": ["string", "null"]}}}},
    "facts": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["subject_mention", "primary_window", "support_windows", "categories", "claim"], "properties": {"subject_mention": {"type": "integer", "minimum": 0}, "primary_window": {"type": "integer", "minimum": 0}, "support_windows": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}}, "categories": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["structure", "encoding", "value", "syntax"]}}, "claim": {"anyOf": [{"$ref": "#/$defs/attributeClaim"}, {"$ref": "#/$defs/linkClaim"}]}}}}
  },
  "$defs": {
    "objectKind": {"enum": ["dataset", "table", "group", "array", "record", "variable", "field", "dimension"]},
    "sourceName": {"type": "object", "additionalProperties": false, "required": ["unit_index", "surface", "occurrence"], "properties": {"unit_index": {"type": "integer", "minimum": 0}, "surface": {"type": "string", "minLength": 1}, "occurrence": {"type": "integer", "minimum": 0}}},
    "target": {"type": "object", "additionalProperties": false, "required": ["kind", "normalized_label", "source_name"], "properties": {"kind": {"$ref": "#/$defs/objectKind"}, "normalized_label": {"type": "string", "minLength": 1}, "source_name": {"$ref": "#/$defs/sourceName"}}},
    "reportedAssertion": {"type": "object", "additionalProperties": false, "required": ["status", "value", "basis"], "properties": {"status": {"const": "reported"}, "value": {"type": "string", "minLength": 1}, "basis": {"type": "null"}}},
    "inferredAssertion": {"type": "object", "additionalProperties": false, "required": ["status", "value", "basis"], "properties": {"status": {"const": "inferred"}, "value": {"type": "string", "minLength": 1}, "basis": {"type": "string", "minLength": 1}}},
    "unknownAssertion": {"type": "object", "additionalProperties": false, "required": ["status", "value", "basis"], "properties": {"status": {"const": "unknown"}, "value": {"type": "null"}, "basis": {"type": "null"}}},
    "assertion": {"anyOf": [{"$ref": "#/$defs/reportedAssertion"}, {"$ref": "#/$defs/inferredAssertion"}, {"$ref": "#/$defs/unknownAssertion"}]},
    "attributeClaim": {"type": "object", "additionalProperties": false, "required": ["kind", "predicate", "assertion"], "properties": {"kind": {"const": "attribute"}, "predicate": {"enum": ["reported_name", "canonical_path", "datatype", "shape", "description", "unit", "value_domain", "spatial_meaning", "temporal_meaning", "analytical_role", "constraint", "encoding", "syntax"]}, "assertion": {"$ref": "#/$defs/assertion"}}},
    "linkClaim": {"type": "object", "additionalProperties": false, "required": ["kind", "predicate", "target", "assertion"], "properties": {"kind": {"const": "link"}, "predicate": {"enum": ["parent", "relationship", "same_as"]}, "target": {"$ref": "#/$defs/target"}, "assertion": {"$ref": "#/$defs/assertion"}}}
  }
}
