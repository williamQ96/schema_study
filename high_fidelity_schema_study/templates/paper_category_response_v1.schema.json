{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paper-category-response/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_identity",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "paper-category-response/v1"
    },
    "source_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "paper_sha256",
        "preprocessing_sha256"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "paper_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "preprocessing_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unit_id",
          "page",
          "state",
          "categories",
          "evidence_spans",
          "rationale"
        ],
        "properties": {
          "unit_id": {
            "type": "string",
            "minLength": 1
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "state": {
            "enum": [
              "classified",
              "none",
              "uncertain"
            ]
          },
          "categories": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "structure",
                "encoding",
                "value",
                "syntax"
              ]
            }
          },
          "evidence_spans": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start",
                "end",
                "quote"
              ],
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
